# =============================================================================
# wisepen-chat-service/Dockerfile.local
# -----------------------------------------------------------------------------
# 本地内测专用镜像。基于本机已有 local/wisepencloud-chat:dev，避免重复安装
# docling / torch 等重依赖；生产仍使用仓库根目录 Dockerfile。
# =============================================================================

FROM ghcr.io/astral-sh/uv:0.6-python3.11-bookworm-slim AS uv-bin

FROM local/wisepencloud-chat:dev

WORKDIR /app

COPY --from=uv-bin /usr/local/bin/uv /usr/local/bin/uv
RUN rm -rf services
COPY pyproject.toml uv.lock ./
COPY services/ services/

RUN uv sync --frozen --inexact --package wisepen-chat-service --no-dev

ENV PYTHONUNBUFFERED=1 \
    HF_HOME=/opt/wisepen/cache/huggingface \
    DOCLING_CACHE_DIR=/opt/wisepen/cache/docling \
    TORCH_HOME=/opt/wisepen/cache/torch \
    XDG_CACHE_HOME=/opt/wisepen/cache \
    OMP_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    NUMEXPR_NUM_THREADS=4

WORKDIR /app/services/wisepen-chat-service/src

EXPOSE 19914

CMD ["sh", "-c", "exec uvicorn chat.main:app --host 0.0.0.0 --port ${SERVICE_PORT:-19914}"]
