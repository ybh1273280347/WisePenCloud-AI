      "anchor_labels": [],
      "content_hash": "3980bf4a5546db6de8399559dd744973b48642ab313240d0b42ae50d22503647"
    },
    {
      "chunk_id": "chunk:23:584230ac6eba8f84",
      "text": "```python\n                \"tokens\": chunk.content_token_count,\n                \"overflow\": chunk.overflow,\n                \"section\": chunk.section_path,\n            }\n        )\n    return records\n\n\ndef display_records(records):\n    for record in records:\n        print(record[\"index\"], record[\"tokens\"])\n        print(record[\"section\"], record[\"overflow\"])\n    print(\"inspection complete\")\n    print(\"all source records retained\")\n```\n",
      "chunk_index": 23,
      "node_ids": [
        "node-15"
      ],
      "section_path": [
